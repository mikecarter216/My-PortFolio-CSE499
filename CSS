<style>
    body {
      margin: 0;
      position: relative;
      scroll-behavior: smooth;
    }

    /* 🌑 CINEMATIC GRADIENT BACKGROUND */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background: linear-gradient(135deg, rgba(0, 40, 120, 0.45), rgba(80, 0, 0, 0.45));
      z-index: -1;
      pointer-events: none;
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at top, rgba(255, 255, 255, 0.05), transparent 60%);
      z-index: -1;
      pointer-events: none;
    }

    .hero-fixed {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 20rem;
      z-index: 1000;
      background-image: url('https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=1950&q=80');
      background-size: cover;
      background-position: center;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.65);
    }

    .hero-content {
      position: relative;
      z-index: 10;
    }

    .header-space {
      height: 20rem;
    }

    #typewriter {
      min-height: 1.5em; 
      display: inline-block;
      width: 100%;
    }

    #scrollTopBtn {
      position: fixed;
      bottom: 30px;
      right: 30px;
      z-index: 50;
      display: none;
      background-color: #2563eb;
      color: white;
      border: none;
      padding: 0.6rem 1rem;
      border-radius: 9999px;
      cursor: pointer;
      font-weight: bold;
      transition: all 0.3s ease;
    }

    #scrollTopBtn:hover {
      background-color: #1d4ed8;
      transform: translateY(-3px);
    }

    #tsparticles {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -2;
    }

    .card-hover {
      transition: all 0.3s ease;
    }
    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    }

    .tech-tag {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.1rem 0.5rem;
      border-radius: 9999px;
      text-transform: uppercase;
    }

    .exp-item {
      position: relative;
    }
    
    .exp-dot {
      position: absolute;
      left: -2.5rem;
      top: 0.25rem;
      width: 1rem;
      height: 1rem;
      background-color: #2563eb;
      border-radius: 9999px;
      border: 3px solid white;
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.3);
      z-index: 20;
    }
